# Copy to .env.local for local dev; set the real values in Cloudflare Pages
# Project settings > Environment variables.

RESEND_API_KEY=re_xxx
CONTACT_TO_EMAIL=info@swingtheory.golf
CONTACT_FROM_EMAIL=noreply@swingtheory.golf

# Cloudflare Turnstile (get sitekey + secret in the Cloudflare dashboard)
TURNSTILE_SITE_KEY=0x4AAAAAAAxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxx

# Square membership checkout — backend (Pages Function secrets/vars).
# SQUARE_ACCESS_TOKEN is secret: `wrangler pages secret put SQUARE_ACCESS_TOKEN`.
# SQUARE_LOCATION_ID / SQUARE_ENV are plain [vars] in wrangler.toml.
SQUARE_ACCESS_TOKEN=EAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SQUARE_LOCATION_ID=LQ77M71PA1N9T
SQUARE_ENV=sandbox

# Square membership checkout — frontend (Vite, must be prefixed VITE_,
# public/safe to ship in the bundle — never put the access token here).
VITE_SQUARE_APP_ID=sandbox-sq0idb-y6mOLrHV8hOgHD3CdC0Qfg
VITE_SQUARE_LOCATION_ID=LQ77M71PA1N9T
VITE_SQUARE_ENV=sandbox

# mm-api provisioning handoff. Base URL is a plain [vars] entry in
# wrangler.toml; the shared secret is set as a Pages secret and must
# match the same-named secret on the mm-api-prod Worker:
#   wrangler pages secret put INTERNAL_PROVISIONING_SECRET
MM_API_BASE_URL=https://mm-api-prod.swingtheoryla.workers.dev
INTERNAL_PROVISIONING_SECRET=<hex-string-shared-with-mm-api>

